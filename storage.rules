rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /recordings/{allPaths=**} {
      allow read, write: if true;
    }
    match /lessonMedia/{allPaths=**} {
      allow read, write: if true;
    }
    match /activityMedia/{allPaths=**} {
      allow read, write: if true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}