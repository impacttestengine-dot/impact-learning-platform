<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Recordings | Impact</title>
<link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/impact-global-bg.css">
<link rel="stylesheet" href="/css/live-classroom.css">
<link rel="stylesheet" href="/css/impact-round-icons.css?v=001">
</head>
<body>
<script src="/js/impact-global-bg.js"></script>

<nav class="lc-nav">
  <a class="lc-nav-btn" href="/teacher/live-classroom.html" title="Back">
    <svg viewBox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"/><path d="M9 12h11"/></svg>
  </a>
  <a class="lc-nav-btn" href="/teacher/dashboard.html" title="Dashboard">
    <svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><rect x="13" y="13" width="7" height="7" rx="2"/></svg>
  </a>
</nav>

<main class="recordings-page">
  <h1>Recordings</h1>
  <p class="sub">All class recordings saved from the Live Classroom.</p>
  <div id="recGrid" class="rec-grid">
    <div class="empty-state"><h3>Loading...</h3></div>
  </div>
</main>

<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore-compat.js"></script>
<script src="/__/firebase/init.js"></script>

<script>
document.addEventListener("DOMContentLoaded", async function(){
  const db   = firebase.firestore();
  const grid = document.getElementById("recGrid");

  try{
    const snap = await db.collection("recordings").orderBy("createdAt","desc").get();

    if(snap.empty){
      grid.innerHTML = `<div class="empty-state">
        <h3>No recordings yet</h3>
        <p>Start a Live Classroom session and record it.<br>Recordings appear here automatically.</p>
      </div>`;
      return;
    }

    grid.innerHTML = "";

    snap.docs.forEach(doc=>{
      const r    = doc.data();
      const date = r.createdAt ? new Date(r.createdAt).toLocaleString() : "Unknown date";
      const card = document.createElement("div");
      card.className = "rec-card";
      card.innerHTML = `
        <div class="rec-card-title" title="${r.meetingTitle||r.meetingId||"Recording"}">${r.meetingTitle||"Untitled Meeting"}</div>
        <div class="rec-card-meta">
          📅 ${date}<br>
          🆔 ${r.meetingId||""}<br>
          👤 Recorded by ${r.recordedBy||"Unknown"}
        </div>
        <div class="rec-actions">
          <a class="rec-btn" href="${r.downloadURL}" target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Play
          </a>
          <a class="rec-btn" href="${r.downloadURL}" download target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download
          </a>
          <button class="rec-btn" data-id="${doc.id}" data-path="${r.storagePath||""}" onclick="deleteRec(this)" style="border-color:rgba(255,100,100,.25);color:#feb2b2">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
            Delete
          </button>
        </div>`;
      grid.appendChild(card);
    });
  }catch(e){
    grid.innerHTML = `<div class="empty-state"><h3>Could not load recordings</h3><p>${e.message}</p></div>`;
  }
});

async function deleteRec(btn){
  if(!confirm("Delete this recording permanently?")) return;
  const db = firebase.firestore();
  try{
    await db.collection("recordings").doc(btn.dataset.id).delete();
    btn.closest(".rec-card").remove();
    const grid = document.getElementById("recGrid");
    if(!grid.querySelector(".rec-card")){
      grid.innerHTML = `<div class="empty-state"><h3>No recordings yet</h3></div>`;
    }
  }catch(e){
    alert("Could not delete: " + e.message);
  }
}
</script>

<script src="/js/impact-page-nav.js"></script>
<script src="/js/impact-round-icons.js?v=001"></script>
<script src="/js/impact-recycle-bin.js"></script>
<script src="/js/impact-route-guard.js?v=inactivity-1hr"></script>
</body>
</html>