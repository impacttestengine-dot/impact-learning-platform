<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Teacher Dashboard | Impact</title>

<link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/impact-global-bg.css?v=dashboard-reset-001">
<link rel="stylesheet" href="/css/impact-round-icons.css?v=001">

<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{min-height:100%}
body{min-height:100vh;font-family:Inter,system-ui,sans-serif;color:#fff;background:#05060b;overflow-x:hidden}

.dashboard-home-btn{
  position:fixed;top:24px;left:28px;z-index:2147483647;text-decoration:none;color:#fff;
  font-size:.72rem;font-weight:900;padding:10px 14px;border-radius:14px;
  background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(18px)
}

.dashboard-menu-wrap{position:fixed!important;top:24px!important;right:28px!important;z-index:2147483647!important}
.dashboard-toggle-btn{
  width:46px!important;height:46px!important;display:flex!important;align-items:center!important;justify-content:center!important;
  border:1px solid rgba(255,255,255,.22)!important;border-radius:16px!important;background:rgba(255,255,255,.16)!important;
  color:#fff!important;font-size:28px!important;font-weight:900!important;cursor:pointer!important;backdrop-filter:blur(18px)!important
}
.dashboard-toggle-menu{
  position:absolute;top:52px;right:0;display:none;min-width:240px;padding:10px;border-radius:18px;
  background:rgba(8,10,18,.94);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(18px)
}
.dashboard-menu-wrap.open .dashboard-toggle-menu{display:grid;gap:8px}
.dashboard-toggle-menu a{color:#fff;text-decoration:none;padding:10px 12px;border-radius:12px;font-size:.78rem;font-weight:800}
.dashboard-toggle-menu a:hover{background:rgba(255,255,255,.12)}

.dashboard-page{position:relative;z-index:2;width:min(1060px,88vw);margin:0 auto;padding:78px 0 80px}
.dashboard-header{text-align:center;margin-bottom:36px}
.dashboard-header .eyebrow{text-transform:uppercase;letter-spacing:.34em;font-size:.68rem;font-weight:900;color:rgba(235,240,255,.64);margin-bottom:10px}
.dashboard-header h1{font-family:"Sorts Mill Goudy",Georgia,serif;font-size:clamp(2.4rem,5vw,4.4rem);font-weight:400;line-height:1.02;text-align:center}

.dashboard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}

.dashboard-card{
  min-height:154px;display:block;text-decoration:none;color:#fff;padding:25px;border-radius:28px;
  background:rgba(255,255,255,.065);border:1px solid rgba(255,255,255,.12);
  box-shadow:0 22px 64px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter:blur(20px);transition:.2s ease
}
.dashboard-card:hover{transform:translateY(-2px);background:rgba(255,255,255,.095)}
.dashboard-card h2{font-family:"Sorts Mill Goudy",Georgia,serif;font-size:1.85rem;font-weight:400;margin-bottom:32px}
.dashboard-card p{color:rgba(255,255,255,.66);font-size:.82rem;font-weight:700;line-height:1.55}

.impact-recycle-shortcut{
  position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9998;width:52px;height:52px;border-radius:50%;
  border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;display:flex;align-items:center;justify-content:center;
  cursor:pointer;backdrop-filter:blur(18px);box-shadow:0 18px 50px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.12);font-size:1.25rem
}
.impact-recycle-shortcut:hover{transform:translateX(-50%) translateY(-3px) scale(1.05);background:rgba(255,255,255,.13)}

@media(max-width:760px){
  .dashboard-grid{grid-template-columns:1fr}
  .dashboard-page{width:min(92vw,620px)}
}

.live-class-btn{
  position:fixed !important;
  top:24px !important;
  right:92px !important;
  width:46px !important;
  height:46px !important;
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  border-radius:16px !important;
  background:rgba(6,182,212,.28) !important;
  border:1px solid rgba(6,182,212,.55) !important;
  backdrop-filter:blur(18px) !important;
  color:#67e8f9 !important;
  text-decoration:none !important;
  z-index:2147483647 !important;
  transition:.22s ease !important;
  box-shadow:0 8px 24px rgba(6,182,212,.25), inset 0 1px 0 rgba(255,255,255,.1) !important;
}
.live-class-btn:hover{
  transform:translateY(-2px) scale(1.05) !important;
  background:rgba(6,182,212,.42) !important;
  box-shadow:0 14px 36px rgba(6,182,212,.35) !important;
}
.live-class-btn svg{
  width:22px !important;
  height:22px !important;
  stroke:currentColor !important;
  stroke-width:2 !important;
  fill:none !important;
  stroke-linecap:round !important;
  stroke-linejoin:round !important;
}


.kpi-snapshot-strip{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:18px 0 8px;max-width:680px;margin-left:auto;margin-right:auto}
.kpi-mini{flex:1;min-width:96px;text-align:center;padding:10px 8px;border-radius:16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1)}
.kpi-mini-label{font-size:.6rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.4);margin-bottom:4px}
.kpi-mini-value{font-family:"Sorts Mill Goudy",Georgia,serif;font-size:1.5rem;font-weight:400}
.kpi-mini-value.good{color:#6ee7b7}
.kpi-mini-value.warn{color:#fbbf24}
.kpi-mini-value.bad{color:#fca5a5}
.kpi-strip-link{display:block;text-align:center;font-size:.72rem;font-weight:800;color:rgba(255,255,255,.35);text-decoration:none;margin-bottom:30px;transition:.15s}
.kpi-strip-link:hover{color:rgba(255,255,255,.6)}</style>
</head>

<body>
<a class="dashboard-home-btn" href="/">Home</a>


<a
class="live-class-btn"
href="/teacher/live-classroom.html"
title="Live Classroom"
aria-label="Live Classroom">

<svg viewBox="0 0 24 24">

<rect
x="3"
y="7"
width="11"
height="10"
rx="2"></rect>

<path
d="M14 10l6-3v10l-6-3z"></path>

</svg>

</a>

<div class="dashboard-menu-wrap" id="dashboardMenuWrap">
  <button class="dashboard-toggle-btn" id="dashboardToggleBtn" type="button" aria-label="Dashboard menu">⋮</button>
  <div class="dashboard-toggle-menu">
    <a href="/teacher/academic-calendar.html">Academic Calendar</a>
    <a href="/teacher/kpis.html">Team KPIs</a>
    <a href="/teacher/marking.html">Marking</a>
    <a href="/teacher/tasks.html">Tasks</a>
    <a href="/teacher/team-docs.html">Team Docs</a>
    <a href="/teacher/operations.html">Operations</a>
  </div>
</div>

<main class="dashboard-page">
  <header class="dashboard-header">
    <p class="eyebrow">Teacher Workspace</p>
    <h1 id="dashboardWelcome">Welcome, <span id="userName">User</span></h1>
  </header>

  <div class="kpi-snapshot-strip" id="kpiSnapshotStrip"></div>
  <a class="kpi-strip-link" href="/teacher/kpis.html">View full KPI breakdown →</a>

  <section class="dashboard-grid">
    <a class="dashboard-card" href="/teacher/records.html">
      <h2>Learner Records</h2>
      <p>Create and manage learner records, levels, notes, and assigned teachers.</p>
    </a>

    <a class="dashboard-card" href="/teacher/lesson-plans.html">
      <h2>Lesson Plans</h2>
      <p>Build structured lesson plans for one-on-one and group learning sessions.</p>
    </a>

    <a class="dashboard-card" href="/teacher/classes.html">
      <h2>Classes</h2>
      <p>Schedule classes, attach meeting links, and manage upcoming sessions.</p>
    </a>

    <a class="dashboard-card" href="/teacher/recordings.html">
      <h2>Recordings</h2>
      <p>Store class recordings, notes, folders, and learner references.</p>
    </a>

    <a class="dashboard-card" href="/teacher/activities.html">
      <h2>Activities</h2>
      <p>Create media-rich exercises for learners and review submitted responses.</p>
    </a>

    <a class="dashboard-card" href="/teacher/delf-mocks.html">
      <h2>DELF Exam Mocks</h2>
      <p>Create assessments, mock exams, test sections, and learner attempts.</p>
    </a>

    <a class="dashboard-card" href="/teacher/progress.html">
      <h2>Progress</h2>
      <p>Review learner growth, teacher comments, scores, and recommendations.</p>
    </a>

    <a class="dashboard-card" href="/teacher/configuration.html">
      <h2>Configuration</h2>
      <p>Manage access controls, passkeys, platform settings, and system rules.</p>
    </a>

    <a class="dashboard-card" href="/teacher/placements/index.html">
      <h2>Learner Placements</h2>
      <p>Create placement tests, manage recordings, and review learner placement reports.</p>
    </a>
  </section>
</main>

<script src="/js/impact-global-bg.js?v=dashboard-reset-001"></script>
<script>
document.addEventListener("DOMContentLoaded", function(){
  const name = sessionStorage.getItem("impactAccessName") || sessionStorage.getItem("impactPersonnelName") || "User";
  const el = document.getElementById("userName");
  if(el) el.textContent = name;

  // ── KPI Snapshot Strip ──────────────────────────────────────
  // Uses the same fuzzy name-matching as kpis.html so a short
  // passkey name (e.g. "Prosper") still correctly links to full
  // names used in class/task records (e.g. "Yormesah Prosper").
  window.addEventListener("load", async function(){
    try{
      if(!window.firebase || !firebase.firestore || name==="User") return;
      const db = firebase.firestore();
      const strip = document.getElementById("kpiSnapshotStrip");
      if(!strip) return;

      function namesMatch(passkeyName, recordName){
        if(!passkeyName || !recordName) return false;
        const a = String(passkeyName).trim().toLowerCase();
        const b = String(recordName).trim().toLowerCase();
        if(!a || !b) return false;
        return a === b || b.includes(a) || a.includes(b);
      }

      function nearestMarkInfo(startedAt){
        const d = new Date(startedAt);
        const minutes = d.getMinutes();
        const lastMark = minutes < 30 ? 0 : 30;
        const nextMark = lastMark === 0 ? 30 : 60;
        const minutesUntilNextMark = nextMark - minutes;
        if(minutesUntilNextMark <= 5){
          const inferred = new Date(d);
          if(nextMark === 60){ inferred.setHours(inferred.getHours()+1, 0, 0, 0); }
          else{ inferred.setMinutes(30, 0, 0); }
          return inferred;
        }
        const inferred = new Date(d);
        inferred.setMinutes(lastMark, 0, 0);
        return inferred;
      }

      function computePunctuality(classes){
        const withStart = classes.filter(x=>x.startedAt);
        if(!withStart.length) return { pct: 0, count: 0 };
        let onTime = 0, counted = 0;
        withStart.forEach(x=>{
          const actual = new Date(x.startedAt);
          let agreedTime = null;
          if(x.time){
            const [schedH, schedM] = String(x.time).split(":").map(Number);
            if(!isNaN(schedH) && !isNaN(schedM)){
              const scheduled = new Date(actual);
              scheduled.setHours(schedH, schedM, 0, 0);
              if(Math.abs(actual - scheduled) / 60000 <= 35) agreedTime = scheduled;
            }
          }
          if(!agreedTime) agreedTime = nearestMarkInfo(x.startedAt);
          const diffMinutes = (actual - agreedTime) / 60000;
          counted++;
          if(diffMinutes <= 5) onTime++;
        });
        return { pct: counted ? Math.round((onTime/counted)*100) : 0, count: counted };
      }

      function tone(pct){ return pct>=80?"good":pct>=50?"warn":"bad"; }

      const [trackerSnap, tasksSnap, completionsSnap] = await Promise.all([
        db.collection("classTracker").get(),
        db.collection("tasks").get(),
        db.collection("learnerCompletions").get().catch(()=>({docs:[]}))
      ]);

      const classes = trackerSnap.docs.map(d=>d.data()).filter(x=>namesMatch(name, x.teacher));
      const personTasks = tasksSnap.docs.map(d=>d.data()).filter(x=>namesMatch(name, x.assignedTo));
      const gradedSubmissions = completionsSnap.docs.map(d=>d.data()).filter(s=>
        namesMatch(name, s.itemCreatedByTeacher) && namesMatch(name, s.markedBy)
      );

      const partVals = classes.map(x=>Number(String(x.studentParticipation||"").replace("%",""))).filter(n=>!isNaN(n));
      const participation = partVals.length ? Math.round(partVals.reduce((a,b)=>a+b,0)/partVals.length) : 0;

      const scoreVals = gradedSubmissions.map(s=>{
        const max = Number(s.maxScore) || 100;
        return (Number(s.score||0)/max)*100;
      }).filter(n=>!isNaN(n));
      const progressRate = scoreVals.length ? Math.round(scoreVals.reduce((a,b)=>a+b,0)/scoreVals.length) : 0;

      const punctualityResult = computePunctuality(classes);

      const doneTasks = personTasks.filter(t=>t.completed).length;
      const taskCompletion = personTasks.length ? Math.round((doneTasks/personTasks.length)*100) : 100;

      strip.innerHTML = `
        <div class="kpi-mini"><div class="kpi-mini-label">Participation</div><div class="kpi-mini-value ${tone(participation)}">${participation}%</div></div>
        <div class="kpi-mini"><div class="kpi-mini-label">Progress Rate</div><div class="kpi-mini-value ${tone(progressRate)}">${progressRate}%</div></div>
        <div class="kpi-mini"><div class="kpi-mini-label">Punctuality</div><div class="kpi-mini-value ${tone(punctualityResult.pct)}">${punctualityResult.pct}%</div></div>
        <div class="kpi-mini"><div class="kpi-mini-label">Tasks Done</div><div class="kpi-mini-value ${tone(taskCompletion)}">${taskCompletion}%</div></div>
      `;
    }catch(e){ console.warn("KPI snapshot failed:", e); }
  });

  const wrap = document.getElementById("dashboardMenuWrap");
  const btn = document.getElementById("dashboardToggleBtn");

  btn.onclick = function(e){
    e.preventDefault();
    e.stopPropagation();
    wrap.classList.toggle("open");
  };

  document.addEventListener("click", function(){ wrap.classList.remove("open"); });
});
</script>

<script src="/js/impact-task-menu-patch.js?v=team-meetings-final"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore-compat.js"></script>
<script src="/__/firebase/init.js"></script>
<script src="/js/impact-task-badge.js"></script>
<script>
document.addEventListener("DOMContentLoaded",function(){
  if(document.getElementById("impactRecycleShortcut")) return;
  const bin = document.createElement("button");
  bin.id = "impactRecycleShortcut";
  bin.className = "impact-recycle-shortcut";
  bin.type = "button";
  bin.title = "Recycle Bin";
  bin.textContent = "♻";
  bin.onclick = () => window.location.href = "/teacher/recycle-bin.html";
  document.body.appendChild(bin);
});
</script>
<script src="/js/impact-round-icons.js?v=001"></script>
<script src="/js/impact-recycle-bin.js"></script>

<script id="team-meetings-menu-fix">
(function(){

  function injectTeamMeetings(){

    const menu =
      document.querySelector(".quick-menu") ||
      document.querySelector(".menu-dropdown") ||
      document.querySelector(".menu-panel") ||
      document.querySelector(".menu-links") ||
      document.querySelector(".dropdown-menu");

    if(!menu) return;

    if(document.getElementById("teamMeetingsMenuLink")) return;

    const recycleLink = Array.from(menu.querySelectorAll("a"))
      .find(a =>
        (a.textContent || "")
          .toLowerCase()
          .includes("recycle")
      );

    if(!recycleLink) return;

    const newLink = recycleLink.cloneNode(true);

    newLink.id = "teamMeetingsMenuLink";

    newLink.href = "/teacher/team-meetings.html";

    newLink.textContent = "Team Meetings";

    // REMOVE INLINE STYLES THAT CAUSED STATIC LOOK
    newLink.removeAttribute("style");

    // insert before recycle bin
    recycleLink.parentNode.insertBefore(newLink, recycleLink);

  }

  injectTeamMeetings();

  setInterval(injectTeamMeetings, 1500);

})();
</script>

<script src="/js/impact-route-guard.js?v=inactivity-1hr"></script>
</body>
</html>













