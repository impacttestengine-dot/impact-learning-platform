<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>DELF Mock Exam | Impact</title>
<link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/impact-global-bg.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,system-ui,sans-serif;background:#05060b;color:#fff;min-height:100vh}
.top-bar{position:fixed;top:0;left:0;right:0;height:58px;z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:rgba(5,6,11,.9);border-bottom:1px solid rgba(255,255,255,.08);backdrop-filter:blur(18px)}
.back-btn{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);color:#fff;text-decoration:none;font-size:.8rem;font-weight:800}
.exam-title-bar{font-family:"Sorts Mill Goudy",serif;font-size:1rem;font-weight:400;color:rgba(255,255,255,.7)}
.exam-meta-badge{font-size:.72rem;font-weight:900;color:#fbbf24;background:rgba(217,119,6,.18);border:1px solid rgba(217,119,6,.35);border-radius:8px;padding:4px 10px}

.exam-page{position:relative;z-index:2;width:min(880px,92vw);margin:0 auto;padding:90px 0 80px}
.exam-header{text-align:center;margin-bottom:34px}
.exam-header h1{font-family:"Sorts Mill Goudy",Georgia,serif;font-size:clamp(2.2rem,5vw,3.2rem);font-weight:400}
.exam-header p{color:rgba(255,255,255,.5);font-weight:700;margin-top:8px}

.doc{border-radius:28px;background:#fff;color:#374151;padding:36px;margin-bottom:20px}
.delf-section-header{display:flex;align-items:center;gap:12px;padding-bottom:14px;border-bottom:2px solid #d97706;margin-bottom:16px}
.delf-section-icon{width:44px;height:44px;border-radius:10px;background:#fef3c7;color:#b45309;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}
.delf-section-title{font-size:1.5rem;font-weight:800;color:#78350f;flex:1}
.delf-section-points{font-size:.8rem;font-weight:800;color:#b45309;background:#fef3c7;padding:5px 12px;border-radius:999px}
.sv-header{font-family:"Sorts Mill Goudy",serif;font-size:2rem;font-weight:400;color:#0f172a;margin-bottom:8px}
.sv-text{font-size:.95rem;color:#4b5563;line-height:1.75}

.delf-audio-player audio{width:100%;margin:10px 0}
.delf-passage-display{background:#fafbfc;border:1.5px solid #e0e3e8;border-radius:10px;padding:18px;font-size:.92rem;line-height:1.8;color:#374151;margin-bottom:16px}
.delf-question-display{border:1.5px solid #e0e3e8;border-radius:10px;padding:16px;margin-bottom:12px}
.delf-question-num{font-size:.72rem;font-weight:900;color:#b45309;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
.delf-question-display .qtext{font-size:.94rem;font-weight:700;color:#0f172a;margin-bottom:10px}
.delf-opt-display{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:9px;border:1.5px solid #e0e3e8;margin-bottom:8px;cursor:pointer;transition:.15s;font-size:.88rem;color:#374151}
.delf-opt-display:hover{border-color:#d97706;background:#fffbeb}
.delf-opt-display input{accent-color:#d97706}

.delf-prompt-display{background:#fafbfc;border:1.5px solid #e0e3e8;border-radius:10px;padding:18px;font-size:.92rem;line-height:1.8;color:#374151;margin-bottom:14px}
.delf-meta-badges{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.delf-meta-badge{background:#fef3c7;color:#b45309;padding:6px 14px;border-radius:999px;font-size:.78rem;font-weight:800}
.delf-writing-area{width:100%;min-height:220px;border:1.5px solid #e0e3e8;border-radius:10px;padding:14px;font-family:Inter,sans-serif;font-size:.9rem;line-height:1.7;color:#374151;resize:vertical}
.delf-word-count{text-align:right;font-size:.76rem;font-weight:700;color:#9ca3af;margin-top:6px}

.delf-speaking-controls{display:flex;gap:12px;margin-top:16px;flex-wrap:wrap}
.delf-timer-display{flex:1;min-width:160px;text-align:center;padding:20px;border-radius:14px;background:#fef3c7;color:#78350f}
.delf-timer-display .time{font-family:"Sorts Mill Goudy",serif;font-size:2.4rem;font-weight:400}
.delf-timer-display .label{font-size:.76rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin-top:4px}
.delf-timer-btn{padding:10px 20px;border-radius:12px;border:none;background:#d97706;color:#fff;font-weight:800;font-size:.86rem;cursor:pointer;font-family:Inter,sans-serif}
.delf-timer-btn:hover{background:#b45309}
.delf-timer-btn:disabled{opacity:.5;cursor:default}

.submit-row{text-align:center;padding:10px 0 40px}
.submit-btn{padding:14px 52px;border-radius:999px;background:#d97706;color:#fff;font-size:.98rem;font-weight:800;border:none;font-family:Inter,sans-serif;cursor:pointer;transition:.15s}
.submit-btn:hover{background:#b45309;transform:translateY(-1px)}

.results-banner{background:#fff;border-radius:22px;padding:26px 30px;margin-bottom:20px;text-align:center}
.results-banner h2{font-family:"Sorts Mill Goudy",serif;font-size:1.8rem;font-weight:400;color:#0f172a;margin-bottom:8px}
.results-banner .score{font-family:"Sorts Mill Goudy",serif;font-size:3rem;font-weight:400;color:#d97706}
.results-banner p{color:#6b7280;font-weight:700;font-size:.88rem;margin-top:6px}
</style>
</head>
<body>
<script src="/js/impact-global-bg.js"></script>
<div class="top-bar">
  <a class="back-btn" href="/teacher/delf-mocks.html">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 5.5 8.5 12 15 18.5"/><path d="M9 12h11"/></svg>
    Back
  </a>
  <span class="exam-title-bar" id="titleBar">DELF Mock Exam</span>
  <span class="exam-meta-badge" id="metaBadge">—</span>
</div>

<main class="exam-page">
  <div class="exam-header">
    <h1 id="examHeading">Loading...</h1>
    <p id="examSub"></p>
  </div>
  <div id="examBody"></div>
</main>

<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore-compat.js"></script>
<script src="/__/firebase/init.js"></script>

<script>
document.addEventListener("DOMContentLoaded", async function(){
  const db = firebase.firestore();
  const id = new URLSearchParams(location.search).get("id");
  const body = document.getElementById("examBody");

  if(!id){ body.innerHTML = '<div class="doc">No exam ID provided.</div>'; return; }

  let plan;
  try{
    const snap = await db.collection("delfMocks").doc(id).get();
    if(!snap.exists){ body.innerHTML = '<div class="doc">Mock exam not found.</div>'; return; }
    plan = { id: snap.id, ...snap.data() };
  }catch(e){
    body.innerHTML = '<div class="doc">Could not load exam.</div>'; return;
  }

  document.getElementById("titleBar").textContent = plan.title || "DELF Mock Exam";
  document.getElementById("metaBadge").textContent = `DELF ${plan.track||"Tout Public"} · ${plan.level||"A1"}`;
  document.getElementById("examHeading").textContent = plan.title || "DELF Mock Exam";
  document.getElementById("examSub").textContent = `DELF ${plan.track||"Tout Public"} — Niveau ${plan.level||"A1"}`;
  document.title = (plan.title||"DELF Mock Exam") + " | Impact";

  const blocks = Array.isArray(plan.blocks) ? plan.blocks : [];
  let html = '<div class="doc">';

  blocks.forEach(b=>{
    if(b.type==="sectionheader"){
      html += `<div class="delf-section-header"><div class="delf-section-icon">§</div><div class="delf-section-title">${b.title||""}</div><div class="delf-section-points">${b.points||""}</div></div>`;
    }
    if(b.type==="header"){
      html += `<div class="sv-header">${b.content||""}</div>`;
    }
    if(b.type==="text"){
      html += `<div class="sv-text" style="margin-bottom:16px">${b.content||""}</div>`;
    }
    if(b.type==="listening"){
      html += `<div class="delf-section-header"><div class="delf-section-icon">🎧</div><div class="delf-section-title">Compréhension Orale</div><div class="delf-section-points">Écoutez l'audio</div></div>`;
      if(b.audioSrc){
        html += `<div class="delf-audio-player"><audio src="${b.audioSrc}" controls></audio></div>`;
      }
      (b.questions||[]).forEach((q,i)=>{
        html += `<div class="delf-question-display"><div class="delf-question-num">Question ${i+1}</div><div class="qtext">${q.question||""}</div>`;
        (q.options||[]).forEach((opt,oi)=>{
          html += `<label class="delf-opt-display"><input type="radio" name="${b.type}_${i}_${Math.random().toString(36).slice(2,6)}"><span>${opt}</span></label>`;
        });
        html += `</div>`;
      });
    }
    if(b.type==="reading"){
      html += `<div class="delf-section-header"><div class="delf-section-icon">📖</div><div class="delf-section-title">Compréhension Écrite</div><div class="delf-section-points">Lisez le texte</div></div>`;
      html += `<div class="delf-passage-display">${b.passage||""}</div>`;
      (b.questions||[]).forEach((q,i)=>{
        html += `<div class="delf-question-display"><div class="delf-question-num">Question ${i+1}</div><div class="qtext">${q.question||""}</div>`;
        (q.options||[]).forEach((opt,oi)=>{
          html += `<label class="delf-opt-display"><input type="radio" name="${b.type}_${i}_${Math.random().toString(36).slice(2,6)}"><span>${opt}</span></label>`;
        });
        html += `</div>`;
      });
    }
    if(b.type==="writing"){
      html += `<div class="delf-section-header"><div class="delf-section-icon">✍</div><div class="delf-section-title">Production Écrite</div><div class="delf-section-points">Points</div></div>`;
      html += `<div class="delf-prompt-display">${b.prompt||""}</div>`;
      html += `<div class="delf-meta-badges">
        ${b.wordCount?`<span class="delf-meta-badge">📝 ${b.wordCount}</span>`:""}
        ${b.timeLimit?`<span class="delf-meta-badge">⏱ ${b.timeLimit} min</span>`:""}
      </div>`;
      html += `<textarea class="delf-writing-area" id="writing_${Math.random().toString(36).slice(2,6)}" placeholder="Écrivez votre réponse ici..." oninput="this.nextElementSibling.textContent=this.value.trim().split(/\\s+/).filter(Boolean).length+' mots'"></textarea>`;
      html += `<div class="delf-word-count">0 mots</div>`;
    }
    if(b.type==="speaking"){
      const speakSeconds = (parseInt(b.speakTime)||5)*60;
      const prepSeconds = (parseInt(b.prepTime)||10)*60;
      html += `<div class="delf-section-header"><div class="delf-section-icon">🗣</div><div class="delf-section-title">Production Orale</div><div class="delf-section-points">Points</div></div>`;
      html += `<div class="delf-prompt-display">${b.prompt||""}</div>`;
      html += `<div class="delf-meta-badges">
        ${b.prepTime?`<span class="delf-meta-badge">🕐 Préparation: ${b.prepTime} min</span>`:""}
        ${b.speakTime?`<span class="delf-meta-badge">🎤 Passage: ${b.speakTime} min</span>`:""}
      </div>`;
      const timerId = "timer_"+Math.random().toString(36).slice(2,8);
      html += `<div class="delf-speaking-controls">
        <div class="delf-timer-display">
          <div class="time" id="${timerId}_prep">${String(Math.floor(prepSeconds/60)).padStart(2,"0")}:${String(prepSeconds%60).padStart(2,"0")}</div>
          <div class="label">Préparation</div>
        </div>
        <div class="delf-timer-display">
          <div class="time" id="${timerId}_speak">${String(Math.floor(speakSeconds/60)).padStart(2,"0")}:${String(speakSeconds%60).padStart(2,"0")}</div>
          <div class="label">Temps de parole</div>
        </div>
      </div>
      <div style="text-align:center;margin-top:14px">
        <button class="delf-timer-btn" onclick="startDelfTimer('${timerId}_prep',${prepSeconds},this)">Démarrer la préparation</button>
        <button class="delf-timer-btn" onclick="startDelfTimer('${timerId}_speak',${speakSeconds},this)" style="margin-left:10px">Démarrer le passage</button>
      </div>`;
    }
  });

  html += '</div>';
  html += `<div class="submit-row"><button class="submit-btn" onclick="alert('Exam responses noted. Submission tracking can be added if needed.')">Terminer l'examen</button></div>`;

  body.innerHTML = html;
});

function startDelfTimer(elId, totalSeconds, btn){
  btn.disabled = true;
  let remaining = totalSeconds;
  const el = document.getElementById(elId);
  const interval = setInterval(()=>{
    remaining--;
    if(remaining < 0){
      clearInterval(interval);
      el.textContent = "00:00";
      btn.disabled = false;
      return;
    }
    const m = String(Math.floor(remaining/60)).padStart(2,"0");
    const s = String(remaining%60).padStart(2,"0");
    el.textContent = m+":"+s;
  }, 1000);
}
</script>
<script src="/js/impact-route-guard.js?v=inactivity-1hr"></script>
</body>
</html>