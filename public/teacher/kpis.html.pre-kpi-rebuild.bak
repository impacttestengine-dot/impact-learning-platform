<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Team KPIs | Impact</title>
<link href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/impact-global-bg.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{min-height:100vh;background:#05060b;color:#fff;font-family:Inter,sans-serif}
.page{position:relative;z-index:2;width:min(1080px,92vw);margin:auto;padding:110px 0 90px}
.nav{position:fixed;top:24px;left:28px;z-index:20;display:flex;gap:12px}
.nav a{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:white;text-decoration:none;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(18px)}
.hero{text-align:center;margin-bottom:32px}
.hero h1{font-family:"Sorts Mill Goudy",serif;font-size:clamp(3rem,6vw,5.6rem);font-weight:400}
.hero p{color:rgba(255,255,255,.65);font-weight:800}

.personnel-selector{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:36px}
.personnel-chip{padding:11px 20px;border-radius:16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.65);font-weight:800;font-size:.86rem;cursor:pointer;transition:.18s}
.personnel-chip:hover{background:rgba(255,255,255,.1)}
.personnel-chip.active{background:rgba(99,179,237,.22);border-color:rgba(99,179,237,.5);color:#90cdf4}

.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-bottom:20px}
.kpi-card{border-radius:26px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(22px);padding:24px}
.kpi-card-cat{font-size:.68rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.4);margin-bottom:8px}
.kpi-card h3{font-family:"Sorts Mill Goudy",serif;font-size:1.4rem;font-weight:400;margin-bottom:12px}
.kpi-value-row{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px}
.kpi-value{font-family:"Sorts Mill Goudy",serif;font-size:2.4rem;font-weight:400}
.kpi-target{font-size:.76rem;font-weight:800;color:rgba(255,255,255,.4)}
.kpi-bar-track{height:8px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden;margin-bottom:8px}
.kpi-bar-fill{height:100%;border-radius:999px;transition:width .5s ease}
.kpi-bar-fill.good{background:linear-gradient(90deg,#34d399,#10b981)}
.kpi-bar-fill.warn{background:linear-gradient(90deg,#fbbf24,#f59e0b)}
.kpi-bar-fill.bad{background:linear-gradient(90deg,#f87171,#ef4444)}
.kpi-desc{font-size:.78rem;color:rgba(255,255,255,.5);font-weight:700;line-height:1.5}
.kpi-source{font-size:.68rem;color:rgba(255,255,255,.3);font-weight:700;margin-top:8px}

.empty-state{text-align:center;padding:60px;color:rgba(255,255,255,.35);font-weight:700}
</style>
</head>
<body>
<script src="/js/impact-global-bg.js"></script>
<nav class="nav"><a href="/teacher/dashboard.html">⌘</a></nav>

<main class="page">
<section class="hero">
<h1>Team KPIs</h1>
<p>Select a team member to view their individual performance breakdown.</p>
</section>

<div class="personnel-selector" id="personnelSelector">
  <div class="empty-state" style="padding:20px">Loading personnel...</div>
</div>

<div class="kpi-grid" id="kpiGrid">
  <div class="empty-state">Select a team member above to view their KPIs.</div>
</div>
</main>

<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore-compat.js"></script>
<script src="/__/firebase/init.js"></script>
<script>
document.addEventListener("DOMContentLoaded", async()=>{
  const db=firebase.firestore();
  const selector=document.getElementById("personnelSelector");
  const grid=document.getElementById("kpiGrid");

  function barClass(pct){
    if(pct>=80) return "good";
    if(pct>=50) return "warn";
    return "bad";
  }

  async function computeKpisFor(personName){
    const [trackerSnap, progressSnap, tasksSnap] = await Promise.all([
      db.collection("classTracker").where("teacher","==",personName).get(),
      db.collection("progressRecords").where("teacher","==",personName).get().catch(()=>({docs:[]})),
      db.collection("tasks").where("assignedTo","==",personName).get()
    ]);

    const classes = trackerSnap.docs.map(d=>d.data());
    const progress = progressSnap.docs.map(d=>d.data());
    const personTasks = tasksSnap.docs.map(d=>d.data());

    // Participation
    const participationVals = classes.map(x=>Number(String(x.studentParticipation||"").replace("%",""))).filter(n=>!isNaN(n));
    const participation = participationVals.length ? Math.round(participationVals.reduce((a,b)=>a+b,0)/participationVals.length) : 0;

    // Progress rate
    const progressVals = progress.map(x=>{
      if(x.maxScore) return (Number(x.score||0)/Number(x.maxScore))*100;
      return Number(x.score||0);
    }).filter(n=>!isNaN(n));
    const progressRate = progressVals.length ? Math.round(progressVals.reduce((a,b)=>a+b,0)/progressVals.length) : 0;

    // Punctuality — completed classes as proxy
    const completedClasses = classes.filter(x=>String(x.status||"").toLowerCase().includes("completed") || x.billable);
    const punctuality = classes.length ? Math.round((completedClasses.length/classes.length)*100) : 0;

    // Task completion
    const doneTasks = personTasks.filter(t=>t.completed).length;
    const taskCompletion = personTasks.length ? Math.round((doneTasks/personTasks.length)*100) : 100;

    // Satisfaction + Quality
    const satVals = progress.map(x=>Number(x.studentSatisfaction)).filter(n=>!isNaN(n));
    const satisfaction = satVals.length ? (satVals.reduce((a,b)=>a+b,0)/satVals.length) : 0;

    const qualityVals = progress.map(x=>Number(x.teachingQuality)).filter(n=>!isNaN(n));
    const quality = qualityVals.length ? (qualityVals.reduce((a,b)=>a+b,0)/qualityVals.length) : 0;

    return { participation, progressRate, punctuality, taskCompletion, satisfaction, quality, classCount: classes.length, taskCount: personTasks.length };
  }

  function renderKpis(name, k){
    const cards = [
      {cat:"Engagement", title:"Student Participation", value:k.participation+"%", pct:k.participation, target:"≥80%", desc:"Average % of lesson blocks where the student actively participated.", source:"Class Tracker · "+k.classCount+" classes"},
      {cat:"Learning Outcomes", title:"Student Progress Rate", value:k.progressRate+"%", pct:k.progressRate, target:"≥65%", desc:"% of students meeting pass mark across activities and assessments.", source:"Progress Records"},
      {cat:"Professionalism", title:"Punctuality", value:k.punctuality+"%", pct:k.punctuality, target:"100%", desc:"Classes started and completed as scheduled.", source:"Class Tracker"},
      {cat:"Professionalism", title:"Task Completion", value:k.taskCompletion+"%", pct:k.taskCompletion, target:"100%", desc:"Administrative and teaching tasks completed on time.", source:"Tasks · "+k.taskCount+" assigned"},
      {cat:"Student Satisfaction", title:"Satisfaction Rating", value:k.satisfaction.toFixed(1)+"/5", pct:(k.satisfaction/5)*100, target:"≥4/5", desc:"Average learner satisfaction rating from feedback.", source:"Feedback Records"},
      {cat:"Teaching Quality", title:"Clarity of Instruction", value:k.quality.toFixed(1)+"/5", pct:(k.quality/5)*100, target:"≥4/5", desc:"Average learner rating on clarity of explanations.", source:"Feedback Records"}
    ];

    grid.innerHTML = cards.map(c=>`
      <div class="kpi-card">
        <div class="kpi-card-cat">${c.cat}</div>
        <h3>${c.title}</h3>
        <div class="kpi-value-row">
          <span class="kpi-value">${c.value}</span>
          <span class="kpi-target">Target ${c.target}</span>
        </div>
        <div class="kpi-bar-track"><div class="kpi-bar-fill ${barClass(c.pct)}" style="width:${Math.min(c.pct,100)}%"></div></div>
        <p class="kpi-desc">${c.desc}</p>
        <p class="kpi-source">${c.source}</p>
      </div>
    `).join("");
  }

  async function loadPersonnel(){
    try{
      const snap = await db.collection("impactPasskeys").where("role","!=","Learner").get();
      const people = snap.docs.map(d=>d.data()).filter(p=>p.name);

      if(!people.length){
        selector.innerHTML = '<div class="empty-state" style="padding:20px">No personnel found. Create passkeys in Configuration first.</div>';
        return;
      }

      selector.innerHTML = people.map(p=>`<button class="personnel-chip" data-name="${p.name}" type="button">${p.name}</button>`).join("");

      selector.addEventListener("click", async function(e){
        const chip = e.target.closest(".personnel-chip");
        if(!chip) return;
        document.querySelectorAll(".personnel-chip").forEach(c=>c.classList.remove("active"));
        chip.classList.add("active");
        grid.innerHTML = '<div class="empty-state">Loading KPIs...</div>';
        const k = await computeKpisFor(chip.dataset.name);
        renderKpis(chip.dataset.name, k);
      });

      // Auto-select first person
      selector.querySelector(".personnel-chip").click();
    }catch(e){
      console.error(e);
      selector.innerHTML = '<div class="empty-state" style="padding:20px">Could not load personnel.</div>';
    }
  }

  await loadPersonnel();
});
</script>
<script src="/js/impact-route-guard.js?v=inactivity-1hr"></script>
</body>
</html>