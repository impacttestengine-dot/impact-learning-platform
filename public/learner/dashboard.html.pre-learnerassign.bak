<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Learner Hub | Impact</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Sorts+Mill+Goudy&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/impact-global-bg.css">
<link rel="stylesheet" href="/css/impact-round-icons.css?v=001">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{min-height:100vh;background:#0d0a1f;color:#fff;font-family:'Inter',system-ui,sans-serif;overflow-x:hidden}

/* Warmer, softer gradient backdrop over the standard global bg */
.hub-warmth{position:fixed;inset:0;z-index:1;pointer-events:none;background:
  radial-gradient(circle at 15% 10%, rgba(251,191,36,.12), transparent 45%),
  radial-gradient(circle at 85% 15%, rgba(236,72,153,.10), transparent 45%),
  radial-gradient(circle at 50% 90%, rgba(139,92,246,.10), transparent 50%);
}

.learner-home-btn{position:fixed;top:24px;left:24px;z-index:9999;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;color:#fff;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);backdrop-filter:blur(18px);font-size:1.2rem;transition:.18s ease}
.learner-home-btn:hover{transform:translateY(-2px) scale(1.05);background:rgba(255,255,255,.18)}

.page{position:relative;z-index:2;width:min(1000px,92vw);margin:0 auto;padding:110px 0 80px}

.hero{text-align:center;margin-bottom:40px}
.eyebrow{text-transform:uppercase;letter-spacing:.3em;font-size:.7rem;font-weight:800;color:rgba(251,191,36,.75);margin-bottom:10px}
.hero h1{font-family:"Sorts Mill Goudy",Georgia,serif;font-size:clamp(2.6rem,6vw,4.4rem);font-weight:400;line-height:1.05;background:linear-gradient(135deg,#fff,#fde68a);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.hero .sub{margin-top:10px;color:rgba(255,255,255,.55);font-weight:600;font-size:.92rem}
.hero .wave{font-size:1.6rem;display:inline-block;animation:wave 2.4s ease-in-out infinite}
@keyframes wave{0%,100%{transform:rotate(0deg)}20%{transform:rotate(16deg)}40%{transform:rotate(-8deg)}60%{transform:rotate(12deg)}}

.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
@media(max-width:760px){.grid{grid-template-columns:1fr}}

.card{
  position:relative;
  min-height:180px;
  padding:28px;
  border-radius:32px;
  text-decoration:none;
  color:#fff;
  overflow:hidden;
  transition:.25s cubic-bezier(.2,.9,.3,1.3);
  border:1px solid rgba(255,255,255,.14);
  backdrop-filter:blur(20px);
}
.card:hover{transform:translateY(-5px) scale(1.015)}

.card.lessons{background:linear-gradient(135deg,rgba(99,102,241,.28),rgba(99,102,241,.08))}
.card.activities{background:linear-gradient(135deg,rgba(236,72,153,.28),rgba(236,72,153,.08))}
.card.assessments{background:linear-gradient(135deg,rgba(217,119,6,.28),rgba(217,119,6,.08))}
.card.progress{background:linear-gradient(135deg,rgba(16,185,129,.28),rgba(16,185,129,.08))}

.card-icon{font-size:2.2rem;margin-bottom:14px;display:block}
.card h2{font-family:"Sorts Mill Goudy",Georgia,serif;font-size:1.9rem;font-weight:400;margin-bottom:10px;display:flex;align-items:center;gap:10px}
.card p{color:rgba(255,255,255,.7);font-weight:600;font-size:.86rem;line-height:1.5}

/* PENDING BADGE — pulses red until all items done, then solid green */
.pending-badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 12px;
  border-radius:999px;
  font-size:.74rem;
  font-weight:800;
  margin-top:14px;
  width:fit-content;
}
.pending-badge.has-pending{
  background:rgba(239,68,68,.25);
  border:1px solid rgba(239,68,68,.5);
  color:#fecaca;
  animation:pulse-red 1.6s ease-in-out infinite;
}
.pending-badge.all-done{
  background:rgba(16,185,129,.22);
  border:1px solid rgba(16,185,129,.45);
  color:#a7f3d0;
}
.pending-badge.none{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.14);
  color:rgba(255,255,255,.45);
}
@keyframes pulse-red{
  0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.5)}
  50%{box-shadow:0 0 0 8px rgba(239,68,68,0)}
}
.pending-dot{width:7px;height:7px;border-radius:50%;background:currentColor;flex-shrink:0}

.streak-strip{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:36px;padding:16px 24px;border-radius:20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);backdrop-filter:blur(14px)}
.streak-strip .emoji{font-size:1.4rem}
.streak-strip p{font-size:.84rem;font-weight:700;color:rgba(255,255,255,.7)}

.loading-hint{text-align:center;color:rgba(255,255,255,.35);font-weight:700;font-size:.82rem;margin-top:16px}
</style>
</head>
<body>
<div class="hub-warmth"></div>
<script src="/js/impact-global-bg.js"></script>
<a class="learner-home-btn" href="/" title="Home">⌂</a>

<main class="page">
  <section class="hero">
    <p class="eyebrow">Learner Hub</p>
    <h1 id="learnerWelcome">Welcome <span class="wave">👋</span></h1>
    <p class="sub" id="levelSub"></p>
  </section>

  <section class="grid">
    <a class="card lessons" href="/learner/lessons.html">
      <span class="card-icon">📚</span>
      <h2>Lessons</h2>
      <p>View assigned lessons and class resources.</p>
      <div class="pending-badge none" id="badge-lessons"><span class="pending-dot"></span>Loading...</div>
    </a>

    <a class="card activities" href="/learner/activities.html">
      <span class="card-icon">🎨</span>
      <h2>Activities</h2>
      <p>Complete assigned activities and exercises.</p>
      <div class="pending-badge none" id="badge-activities"><span class="pending-dot"></span>Loading...</div>
    </a>

    <a class="card assessments" href="/learner/exams.html">
      <span class="card-icon">📝</span>
      <h2>Assessments</h2>
      <p>Open tests, mock exams, and assessment tasks.</p>
      <div class="pending-badge none" id="badge-assessments"><span class="pending-dot"></span>Loading...</div>
    </a>

    <a class="card progress" href="/learner/progress.html">
      <span class="card-icon">🌱</span>
      <h2>Progress</h2>
      <p>Track growth, comments, scores, and recommendations.</p>
    </a>
  </section>

  <div class="streak-strip">
    <span class="emoji">✨</span>
    <p id="motivationLine">Keep going — every lesson brings you closer to fluency!</p>
  </div>
</main>

<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore-compat.js"></script>
<script src="/__/firebase/init.js"></script>
<script src="/js/impact-route-guard.js?v=inactivity-1hr"></script>

<script>
document.addEventListener("DOMContentLoaded", async function(){
  const name  = sessionStorage.getItem("impactAccessName") || sessionStorage.getItem("impactLearnerName") || "";
  const level = sessionStorage.getItem("impactAccessLevel") || "";

  if(name) document.getElementById("learnerWelcome").innerHTML = "Welcome, " + name + ' <span class="wave">👋</span>';
  if(level) document.getElementById("levelSub").textContent = "Level " + level;

  if(!level){
    ["lessons","activities","assessments"].forEach(k=>{
      const b = document.getElementById("badge-"+k);
      if(b){ b.className="pending-badge none"; b.innerHTML='<span class="pending-dot"></span>No level assigned yet'; }
    });
    return;
  }

  const db = firebase.firestore();

  async function getCompletedIds(itemType){
    const snap = await db.collection("learnerCompletions")
      .where("learnerName","==",name)
      .where("itemType","==",itemType)
      .get();
    const ids = new Set();
    snap.forEach(d=>ids.add(d.data().itemId));
    return ids;
  }

  function setBadge(elId, total, doneCount){
    const el = document.getElementById(elId);
    if(!el) return;
    if(total === 0){
      el.className = "pending-badge none";
      el.innerHTML = '<span class="pending-dot"></span>Nothing assigned yet';
      return;
    }
    const pending = total - doneCount;
    if(pending > 0){
      el.className = "pending-badge has-pending";
      el.innerHTML = `<span class="pending-dot"></span>${pending} pending`;
    }else{
      el.className = "pending-badge all-done";
      el.innerHTML = `<span class="pending-dot"></span>All done! 🎉`;
    }
  }

  // ── Lessons ──
  try{
    const lessonsSnap = await db.collection("lessonPlans").where("assignedLevels","array-contains",level).get();
    const lessonIds = lessonsSnap.docs.map(d=>d.id);
    const doneLessons = await getCompletedIds("lesson");
    const doneCount = lessonIds.filter(id=>doneLessons.has(id)).length;
    setBadge("badge-lessons", lessonIds.length, doneCount);
  }catch(e){ console.warn("lessons badge failed", e); }

  // ── Activities ──
  try{
    const actSnap = await db.collection("activityPlans").where("assignedLevels","array-contains",level).get();
    const actIds = actSnap.docs.map(d=>d.id);
    const doneAct = await getCompletedIds("activity");
    const doneCount = actIds.filter(id=>doneAct.has(id)).length;
    setBadge("badge-activities", actIds.length, doneCount);
  }catch(e){ console.warn("activities badge failed", e); }

  // ── DELF Mocks (Assessments) ──
  try{
    const delfSnap = await db.collection("delfMocks").where("assignedLevels","array-contains",level).get();
    const delfIds = delfSnap.docs.map(d=>d.id);
    const doneDelf = await getCompletedIds("delfMock");
    const doneCount = delfIds.filter(id=>doneDelf.has(id)).length;
    setBadge("badge-assessments", delfIds.length, doneCount);
  }catch(e){ console.warn("assessments badge failed", e); }
});
</script>
<script src="/js/impact-round-icons.js?v=001"></script>
<script src="/js/impact-recycle-bin.js"></script>
</body>
</html>