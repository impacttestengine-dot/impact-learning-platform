(function(){
  function findNameArea(){
    const all = Array.from(document.querySelectorAll("h1,h2,.hero h1,.welcome-title,[class*='welcome'],[class*='hero'] h1"));
    return all.find(el => /welcome|adelaide/i.test(el.textContent || "")) || document.querySelector("h1");
  }

  function ensureBadge(){
    let badge = document.getElementById("teacherTaskBadge");

    if(!badge){
      badge = document.createElement("a");
      badge.id = "teacherTaskBadge";
      badge.title = "View tasks";
      badge.href = "/teacher/tasks.html";
      badge.style.textDecoration = "none";
    }

    const nameArea = findNameArea();

    if(nameArea && !nameArea.contains(badge)){
      nameArea.style.display = "inline-flex";
      nameArea.style.alignItems = "center";
      nameArea.style.gap = "16px";
      nameArea.style.flexWrap = "wrap";
      nameArea.appendChild(badge);
    }
  }

  function styleBadge(count){
    const badge = document.getElementById("teacherTaskBadge");
    if(!badge) return;

    const hasPending = count > 0;

    badge.innerHTML = hasPending
      ? `<span class="task-count">${count}</span><span class="task-label">${count===1?'task':'tasks'} due</span>`
      : `<span class="task-icon">✓</span><span class="task-label">All clear</span>`;

    badge.style.position = "relative";
    badge.style.zIndex = "20";
    badge.style.display = "inline-flex";
    badge.style.alignItems = "center";
    badge.style.gap = "8px";
    badge.style.padding = "9px 16px";
    badge.style.borderRadius = "999px";
    badge.style.cursor = "pointer";
    badge.style.verticalAlign = "middle";
    badge.style.backdropFilter = "blur(18px)";
    badge.style.transition = ".2s ease";
    badge.style.border = hasPending ? "1px solid rgba(245,158,11,.5)" : "1px solid rgba(52,211,153,.35)";
    badge.style.background = hasPending ? "rgba(245,158,11,.14)" : "rgba(52,211,153,.1)";

    if(!document.getElementById("taskBadgeIconStyle")){
      const style = document.createElement("style");
      style.id = "taskBadgeIconStyle";
      style.textContent = `
        #teacherTaskBadge:hover{ transform: translateY(-1px); filter: brightness(1.1); }
        #teacherTaskBadge .task-count{
          display:inline-flex; align-items:center; justify-content:center;
          min-width:22px; height:22px; padding:0 6px; border-radius:999px;
          background:#f59e0b; color:#1a1206; font-size:.76rem; font-weight:900;
          animation: taskPulse 1.6s ease-in-out infinite;
        }
        #teacherTaskBadge .task-icon{
          font-size:.9rem; color:#6ee7b7; font-weight:900;
        }
        #teacherTaskBadge .task-label{
          font-size:.76rem; font-weight:800; color:rgba(255,255,255,.85);
          white-space:nowrap;
        }
        @keyframes taskPulse{
          0%,100%{ box-shadow:0 0 0 0 rgba(245,158,11,.55); }
          50%{ box-shadow:0 0 0 6px rgba(245,158,11,0); }
        }
      `;
      document.head.appendChild(style);
    }
  }

  async function checkPending(){
    ensureBadge();

    try{
      if(!window.firebase || !firebase.firestore){
        styleBadge(0);
        return;
      }

      const personName = sessionStorage.getItem("impactAccessName") || sessionStorage.getItem("impactPersonnelName") || "";
      const db = firebase.firestore();

      let query = db.collection("tasks").where("completed","==",false);
      if(personName){
        query = query.where("assignedTo","==",personName);
      }

      const snap = await query.get();
      styleBadge(snap.size);
    }catch(e){
      styleBadge(0);
    }
  }

  setTimeout(checkPending, 400);
  setTimeout(checkPending, 1200);
  setInterval(checkPending, 30000);
})();